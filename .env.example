# FastAPI and DBeaver must point to the same PostgreSQL database.
# DBeaver fields for this local-development example:
#   Host=127.0.0.1  Port=5432  Database=supalai_test  User=postgres
# Change the example password before using this outside local development.
# PostgreSQL is accessed only by FastAPI. Never expose this value to browser code.
DATABASE_URL=postgresql://uwbtracking:Spl12345@uwb-tracking-test.postgres.database.azure.com:5432/postgres?sslmode=require

# Use a long random value shared only by FastAPI and the UWB gateway firmware.
HARDWARE_INGEST_SECRET=replace-with-at-least-32-random-characters

SESSION_HOURS=12
FRONTEND_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
ACTIVATION_HOURS=24
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
SIMULATOR_ENABLED=true

# Adapter for the Makerfabs TCP firmware already installed on the tag.
UWB_LEGACY_TAG_HOST=192.168.1.200
UWB_LEGACY_TAG_PORT=8888
UWB_LEGACY_API_URL=http://127.0.0.1:8000/api/hardware/ingest
UWB_LEGACY_DEVICE_ID=SUPALAI-TAG-GW-01
UWB_LEGACY_TAG_ID=TAG01
# Google Sign-In (Web application OAuth client)
# GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# GOOGLE_WORKSPACE_DOMAIN=supalai.com

# Account email delivery. "auto" uses Gmail API when Gmail credentials exist,
# otherwise SMTP. Use gmail_api explicitly in production after OAuth setup.
MAIL_PROVIDER=auto
# GMAIL_SENDER_EMAIL=no-reply@supalai.com

# Google Workspace option (recommended for unattended sending): service
# account with Domain-Wide Delegation and gmail.send scope. Prefer a secret
# file/Key Vault mount; never commit the JSON key.
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Standard Google OAuth option: offline-consent refresh token for one mailbox.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=

# Optional SMTP fallback
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false
# CORS_ORIGINS=https://tracking.example.com
