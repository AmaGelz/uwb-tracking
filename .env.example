# FastAPI and DBeaver must point to the same PostgreSQL database.
# DBeaver fields for this local-development example:
#   Host=127.0.0.1  Port=5432  Database=supalai_test  User=postgres
# Change the example password before using this outside local development.
# PostgreSQL is accessed only by FastAPI. Never expose this value to browser code.
DATABASE_URL=postgresql://uwbtracking:Spl12345@uwb-tracking-test.postgres.database.azure.com:5432/postgres?sslmode=require

# Use a long random value shared only by FastAPI and the UWB gateway firmware.
HARDWARE_INGEST_SECRET=replace-with-at-least-32-random-characters

SESSION_HOURS=12
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
SIMULATOR_ENABLED=true

# Adapter for the Makerfabs TCP firmware already installed on the tag.
UWB_LEGACY_TAG_HOST=192.168.1.200
UWB_LEGACY_TAG_PORT=8888
UWB_LEGACY_API_URL=http://127.0.0.1:8000/api/hardware/ingest
UWB_LEGACY_DEVICE_ID=SUPALAI-TAG-GW-01
UWB_LEGACY_TAG_ID=TAG01
# GOOGLE_CLIENT_ID=
# CORS_ORIGINS=https://tracking.example.com
